# ==== 应用配置 ====
APP_NAME = rag-konwledge-base
LOG_LEVEL = INFO

# ===== PostgreSQL（docker-compose 与后端共用） =====
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_kb
POSTGRES_PORT=5432

# 后端连接串：注意使用 asyncpg driver
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_kb

# ===== 腾讯云 COS（勿提交真实密钥） =====
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_REGION=ap-chengdu
COS_BUCKET=your_cos_bucket

# ===== Embedding（勿提交真实密钥） =====
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# ===== 文档上传与切片 =====
UPLOAD_MAX_SIZE_MB=50
CHUNK_SIZE=600
CHUNK_OVERLAP=60
